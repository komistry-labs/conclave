# Canonical line endings.
#
# CONCLAVE computes content hashes over canonical bytes, so an artifact hashes
# identically regardless of checkout. This file keeps the SOURCE consistent for
# the same reason it matters in KOS: a CRLF checkout produces noisy diffs and
# makes review harder.

* text=auto eol=lf

*.md    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
